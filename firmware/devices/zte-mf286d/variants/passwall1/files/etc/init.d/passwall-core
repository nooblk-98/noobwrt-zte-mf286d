#!/bin/sh /etc/rc.common
# Fetch the PassWall Xray core into RAM after the WAN is up.
# Runs before passwall (START=99) but completes asynchronously; the fetcher
# restarts passwall once the core is in place.

START=98

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/passwall-core-fetch
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
